---
import { getAllProjects, getUniqueTagsWithCount } from "@/data/project";
import PageLayout from "@/layouts/BaseLayout.astro";

const allProjects = await getAllProjects();
const allTags = getUniqueTagsWithCount(allProjects);

const meta = {
	description: "A list of topics related to the content on this site.",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<h1 class="text-3xl font-mono font-bold tracking-tight mb-8">Tags</h1>

	<ul class="flex flex-wrap gap-3">
		{
			allTags.map(([tag, val]) => (
				<li>
					<a
						href={`/tags/${tag}/`}
						class="inline-flex items-center gap-2 px-4 py-2 border border-border text-text-secondary hover:text-text hover:border-accent transition-colors"
						data-astro-prefetch
						title={`View content with the tag: ${tag}`}
					>
						<span>{tag}</span>
						<span class="text-xs bg-bg-secondary px-1.5 py-0.5">
							{val}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
