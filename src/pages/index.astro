---
import FormattedDate from "@/components/FormatDate.astro";
import { getAllPosts, sortPostsByDate } from "@/data/blog";
import PageLayout from "@/layouts/BaseLayout.astro";

const MAX_POSTS = 5;
const allPosts = await getAllPosts();
const recentPosts = sortPostsByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout
	meta={{
		title: "Nick Wall",
		description:
			"Leading research & engineering @ Maple. Machine learning, mostly — how people and computers interact, what intelligence actually is, and making it abundant and accessible.",
	}}
	showASCIITexture asciiOpacity={0.25}
>
	<section class="mb-16">
		<h1 class="text-4xl sm:text-5xl font-sans font-medium tracking-tight mb-4">
			Nick Wall
		</h1>
		<p class="text-lg text-text-secondary mb-6">
			Currently: leading research & engineering @ Maple
		</p>
		<p class="text-text-secondary max-w-xl leading-relaxed">
			ML, mostly. How people and computers interact. What
			intelligence actually is. And making sure that when intelligence is 
			abundant, everyone can reach it.
		</p>
	</section>

	<section>
		<div class="flex items-baseline justify-between mb-8">
			<h2 class="text-xl font-sans font-medium">Recent Work</h2>
			<a
				href="/blog"
				class="text-sm text-text-secondary hover:text-text transition-colors"
			>
				View all &rarr;
			</a>
		</div>

		<ul class="space-y-6">
			{
				recentPosts.map((post) => {
					const postDate =
						post.data.updatedDate ?? post.data.publishDate;
					return (
						<li class="group">
							<a
								href={`/blog/${post.id}/`}
								class="block py-3 -mx-3 px-3 transition-colors hover:bg-bg-secondary"
								data-astro-prefetch
							>
								<div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
									<FormattedDate
										class="text-sm text-text-secondary shrink-0"
										date={postDate}
									/>
									<div class="flex-1 min-w-0">
										<h3 class="font-medium text-text group-hover:text-accent transition-colors">
											{post.data.draft && (
												<span class="text-text-secondary">(Draft) </span>
											)}
											{post.data.title}
										</h3>
										{post.data.description && (
											<p class="text-sm text-text-secondary mt-1 line-clamp-1">
												{post.data.description}
											</p>
										)}
									</div>
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</PageLayout>
