---
import type { CollectionEntry } from "astro:content";

import Hero from "@/components/project/Hero.astro";
import TOC from "@/components/project/TableOfContents.astro";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const {
	data: { description, ogImage, publishDate, title, updatedDate },
	slug,
} = project;
const socialImage = ogImage ?? `/og-image/${slug}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await project.render();
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }} wide>
	<div class:list={["project-shell", { "has-toc": headings.length > 0 }]}>
		{!!headings.length && <TOC headings={headings} />}
		<article class="project-article break-words" data-pagefind-body>
			<div id="project-hero"><Hero content={project} /></div>
			<div class="project-prose prose max-w-none">
				<slot />
			</div>
			<nav class="project-paginator" aria-label="Article">
				<button type="button" class="project-back-to-top" id="to-top-inline">
					back to top
				</button>
			</nav>
		</article>
	</div>
	<button
		type="button"
		aria-label="Back to top"
		class="to-top-float"
		data-show="false"
		id="to-top-btn"
	>
		back to top
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const inlineBtn = document.getElementById(
		"to-top-inline",
	) as HTMLButtonElement;
	const targetHeader = document.getElementById(
		"project-hero",
	) as HTMLDivElement;
	const footer = document.querySelector("footer");

	let heroVisible = true;
	let footerVisible = false;

	const sync = () => {
		scrollBtn.dataset.show = (!heroVisible && !footerVisible).toString();
	};

	const toTop = () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	};

	scrollBtn.addEventListener("click", toTop);
	inlineBtn.addEventListener("click", toTop);

	const heroObserver = new IntersectionObserver((entries) => {
		heroVisible = Boolean(entries[0]?.isIntersecting);
		sync();
	});
	heroObserver.observe(targetHeader);

	if (footer) {
		const footerObserver = new IntersectionObserver((entries) => {
			footerVisible = Boolean(entries[0]?.isIntersecting);
			sync();
		});
		footerObserver.observe(footer);
	}
</script>
