---
import { render, type CollectionEntry } from "astro:content";

import Hero from "@/components/post/Hero.astro";
import TOC from "@/components/post/TableOfContents.astro";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
	data: { description, ogImage, publishDate, title, updatedDate },
	id,
} = post;
const socialImage = ogImage ?? `/og-image/${id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await render(post);
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }} wide>
	<div class:list={["post-shell", { "has-toc": headings.length > 0 }]}>
		{!!headings.length && <TOC headings={headings} />}
		<article class="post-article break-words">
			<div id="post-hero"><Hero content={post} /></div>
			<div class="post-prose prose max-w-none">
				<slot />
			</div>
			<nav class="post-paginator" aria-label="Article">
				<button type="button" class="post-back-to-top" id="to-top-inline">
					back to top
				</button>
			</nav>
		</article>
	</div>
	<button
		type="button"
		aria-label="Back to top"
		class="to-top-float"
		data-show="false"
		id="to-top-btn"
	>
		back to top
	</button>
</BaseLayout>

<script>
	// Clicks are delegated on `document` so they keep working after the
	// ClientRouter swaps the DOM (module scripts only execute once per session).
	document.addEventListener("click", (event) => {
		const target = event.target as Element | null;
		if (!target?.closest("#to-top-btn, #to-top-inline")) return;

		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		window.scrollTo({
			top: 0,
			behavior: prefersReducedMotion ? "auto" : "smooth",
		});
	});

	let heroVisible = true;
	let footerVisible = false;

	const sync = () => {
		const scrollBtn = document.getElementById("to-top-btn");
		if (scrollBtn) {
			scrollBtn.dataset.show = (
				!heroVisible && !footerVisible
			).toString();
		}
	};

	let heroObserver: IntersectionObserver | undefined;
	let footerObserver: IntersectionObserver | undefined;

	const setupObservers = () => {
		heroObserver?.disconnect();
		footerObserver?.disconnect();

		const targetHeader = document.getElementById("post-hero");
		const footer = document.querySelector("footer");

		heroVisible = true;
		footerVisible = false;

		if (targetHeader) {
			heroObserver = new IntersectionObserver((entries) => {
				heroVisible = Boolean(entries[0]?.isIntersecting);
				sync();
			});
			heroObserver.observe(targetHeader);
		}

		if (footer) {
			footerObserver = new IntersectionObserver((entries) => {
				footerVisible = Boolean(entries[0]?.isIntersecting);
				sync();
			});
			footerObserver.observe(footer);
		}
	};

	// `astro:page-load` fires on initial load and after every client-side
	// navigation, so observers always track the current DOM.
	document.addEventListener("astro:page-load", setupObservers);
	setupObservers();
</script>
