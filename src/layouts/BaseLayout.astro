---
import type { SiteMeta } from "@/types";

import ASCIITexture from "@/components/ASCIITexture";
import CommandPalette from "@/components/CommandPalette.astro";
import Head from "@/components/Head.astro";
import SkipLink from "@/components/SkipLink.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site.config";

import { ClientRouter } from "astro:transitions";

import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/eb-garamond/700.css";
import "@fontsource/eb-garamond/800.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";

interface Props {
	meta: SiteMeta;
	showASCIITexture?: boolean;
	asciiOpacity?: number;
	hideChrome?: boolean;
	wide?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	showASCIITexture = false,
	asciiOpacity = 0.04,
	hideChrome = false,
	wide = false,
} = Astro.props;
---

<html lang={siteConfig.lang}>
	<head>
		<Head
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
		/>
		<ClientRouter />
	</head>
	<body class:list={[{ "layout-wide": wide }]}>
		{showASCIITexture && <ASCIITexture opacity={asciiOpacity} client:only="react" />}
		<SkipLink />

		{!hideChrome && <Header />}
		<CommandPalette />
		<div class="flex-1">
			<main id="main">
				<slot />
			</main>
		</div>
		{!hideChrome && <Footer />}
	</body>
</html>
