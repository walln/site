---
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-12 flex items-center justify-between border-t border-border pt-6">
			{prevUrl ? (
				<a
					href={prevUrl.url}
					class="inline-flex items-center gap-2 text-text-secondary hover:text-text transition-colors"
					data-astro-prefetch
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-4 h-4"
						aria-hidden="true"
					>
						<path d="M19 12H5M12 19l-7-7 7-7" />
					</svg>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text || "Previous"}
				</a>
			) : (
				<div />
			)}
			{nextUrl ? (
				<a
					href={nextUrl.url}
					class="inline-flex items-center gap-2 text-text-secondary hover:text-text transition-colors"
					data-astro-prefetch
				>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text || "Next"}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-4 h-4"
						aria-hidden="true"
					>
						<path d="M5 12h14M12 5l7 7-7 7" />
					</svg>
				</a>
			) : (
				<div />
			)}
		</nav>
	)
}
