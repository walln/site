---
import { Icon } from "astro-icon/components";

// TODO: Addo all other links
const socialLinks: {
	friendlyName: string;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "X",
		link: "https://x.com/nickwal",
		name: "x",
	},
	{
		friendlyName: "Github",
		link: "https://github.com/walln",
		name: "mdi:github",
	},
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/nicholasewall",
		name: "mdi:linkedin",
	},
	{
		friendlyName: "Email",
		link: "mailto:walln@hey.com",
		name: "mdi:email",
	},
];
---

<ul class="flex items-center gap-3">
	{
		socialLinks.map(({ friendlyName, link, name }) => (
			<li>
				<a
					class="inline-flex p-1.5 text-text-secondary hover:text-text transition-colors hover:bg-bg-secondary"
					href={link}
					rel="noopener noreferrer"
					target="_blank"
				>
					<Icon
						aria-hidden="true"
						class="h-5 w-5"
						focusable="false"
						name={name}
					/>
					<span class="sr-only">{friendlyName}</span>
				</a>
			</li>
		))
	}
</ul>
