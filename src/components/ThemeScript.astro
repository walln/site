---
// This script runs before React hydrates to prevent theme flash
// It also handles View Transitions to prevent flash on navigation
---

<script is:inline>
	(function () {
		function getTheme() {
			const stored = localStorage.getItem("theme");
			const prefersDark = window.matchMedia(
				"(prefers-color-scheme: dark)",
			).matches;
			return stored === "light" || stored === "dark"
				? stored
				: prefersDark
					? "dark"
					: "light";
		}

		function applyTheme() {
			document.documentElement.setAttribute("data-theme", getTheme());
		}

		// Apply theme immediately on initial load
		applyTheme();

		// Re-apply theme after View Transitions swap in new page content
		// This prevents flash when navigating between pages
		document.addEventListener("astro:after-swap", applyTheme);
	})();
</script>
