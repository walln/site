---
import Search from "astro-pagefind/components/Search";
---

<!-- Search trigger button -->
<button
	id="magnifying-glass"
	type="button"
	class="p-2 text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors"
	aria-label="Search"
	title="Search (Ctrl+K or /)"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="w-5 h-5"
		aria-hidden="true"
	>
		<circle cx="11" cy="11" r="8" />
		<path d="m21 21-4.3-4.3" />
	</svg>
</button>

<aside data-pagefind-ignore>
	<div
		transition:persist
		id="backdrop"
		class="hidden fixed inset-0 z-[999999] flex justify-center p-6 pt-[15vh]"
		style="background: hsl(var(--color-bg) / 0.8); backdrop-filter: blur(8px);"
	>
		<div
			id="pagefind-container"
			class="h-fit w-full max-w-xl bg-bg border border-border shadow-2xl overflow-hidden"
		>
			<div class="p-4">
				<Search
					id="search"
					className="pagefind-ui"
					uiOptions={{
						showImages: false,
						excerptLength: 15,
						resetStyles: false,
					}}
				/>
				<div
					class="search-instructions flex justify-center gap-6 mt-4 pt-4 border-t border-border text-xs text-text-secondary"
				>
				<span class="flex items-center gap-1.5">
					<kbd class="px-1.5 py-0.5 border border-border text-[0.7rem] bg-bg-secondary">Tab</kbd>
					Navigate
				</span>
				<span class="flex items-center gap-1.5">
					<kbd class="px-1.5 py-0.5 border border-border text-[0.7rem] bg-bg-secondary">Esc</kbd>
					Close
				</span>
				</div>
			</div>
		</div>
	</div>
</aside>

<script is:inline>
	const magnifyingGlass = document.getElementById("magnifying-glass");
	const backdrop = document.getElementById("backdrop");

	// Move backdrop to body to ensure it's not constrained by parent elements
	if (backdrop && backdrop.parentElement !== document.body) {
		document.body.appendChild(backdrop);
	}

	function openPagefind() {
		const searchDiv = document.getElementById("search");
		const search = searchDiv.querySelector("input");
		setTimeout(() => {
			search.focus();
		}, 0);
		backdrop?.classList.remove("hidden");
		backdrop?.classList.add("block");
	}

	function closePagefind() {
		const search = document.getElementById("search");
		search.value = "";
		backdrop?.classList.remove("block");
		backdrop?.classList.add("hidden");
	}

	// open pagefind
	magnifyingGlass?.addEventListener("click", () => {
		openPagefind();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "/") {
			e.preventDefault();
			openPagefind();
		} else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
			e.preventDefault();
			openPagefind();
		}
	});

	// close pagefind
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			closePagefind();
		}
	});

	// close pagefind when searched result(link) clicked
	document.addEventListener("click", (event) => {
		if (event.target.classList.contains("pagefind-ui__result-link")) {
			closePagefind();
		}
	});

	backdrop?.addEventListener("click", (event) => {
		if (!event.target.closest("#pagefind-container")) {
			closePagefind();
		}
	});

	// prevent form submission
	const form = document.getElementById("form");
	form?.addEventListener("submit", (event) => {
		event.preventDefault();
	});
</script>

<style is:global>
	/* Ensure backdrop is always on top */
	#backdrop {
		position: fixed !important;
		z-index: 999999 !important;
	}

	#backdrop.block {
		display: flex !important;
	}

	:root {
		--pagefind-ui-scale: 0.9;
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 0;
		--pagefind-ui-font: inherit;
		--pagefind-ui-primary: hsl(var(--color-accent));
		--pagefind-ui-text: hsl(var(--color-text));
		--pagefind-ui-background: transparent;
		--pagefind-ui-border: hsl(var(--color-border));
		--pagefind-ui-tag: hsl(var(--color-bg-secondary));
	}

	/* Search input */
	#search .pagefind-ui__form {
		position: relative;
		margin-bottom: 1rem;
	}

	#search .pagefind-ui__form::before {
		display: none !important;
	}

	#search .pagefind-ui__search-input {
		width: 100% !important;
		border: 1px solid hsl(var(--color-border)) !important;
		background: hsl(var(--color-bg-secondary)) !important;
		color: hsl(var(--color-text)) !important;
		font-family: inherit !important;
		font-size: 1rem !important;
		padding: 0.75rem 3rem 0.75rem 1rem !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		outline: none !important;
		transition: border-color 150ms ease;
	}

	#search .pagefind-ui__search-input:focus {
		border-color: hsl(var(--color-accent)) !important;
	}

	#search .pagefind-ui__search-input::placeholder {
		color: hsl(var(--color-text-secondary)) !important;
	}

	/* Clear button styling */
	#search .pagefind-ui__search-clear {
		background: transparent !important;
		border: none !important;
		color: hsl(var(--color-text-secondary)) !important;
		right: 0.5rem !important;
		padding: 0.5rem !important;
		transition: color 150ms ease;
	}

	#search .pagefind-ui__search-clear:hover {
		color: hsl(var(--color-text)) !important;
	}

	/* Results container */
	#search .pagefind-ui__results-area {
		display: block;
		width: 100%;
	}

	#search .pagefind-ui__results {
		max-height: 45vh;
		min-height: 100px;
		overflow-y: auto;
		padding: 0.25rem;
	}

	/* Individual result styling */
	#search .pagefind-ui__result {
		border: none !important;
		padding: 0.75rem !important;
		margin: 0 !important;
		border-radius: 0 !important;
		transition: background-color 150ms ease;
		background: transparent !important;
	}

	#search .pagefind-ui__result:hover {
		background-color: hsl(var(--color-bg-secondary)) !important;
	}

	/* Result title styling */
	#search .pagefind-ui__result-title,
	#search .pagefind-ui__result-link {
		color: hsl(var(--color-text)) !important;
		font-family: inherit !important;
		font-size: 0.9375rem !important;
		font-weight: 500 !important;
		text-decoration: none !important;
		transition: color 150ms ease;
	}

	#search .pagefind-ui__result:hover .pagefind-ui__result-link {
		color: hsl(var(--color-accent)) !important;
	}

	/* Result excerpt styling */
	#search .pagefind-ui__result-excerpt {
		color: hsl(var(--color-text-secondary)) !important;
		font-size: 0.875rem !important;
		font-family: inherit !important;
		margin-top: 0.25rem;
		line-height: 1.5;
		font-weight: 400 !important;
	}

	/* Highlight styling */
	#search mark {
		color: hsl(var(--color-accent)) !important;
		background-color: hsl(var(--color-accent) / 0.1) !important;
		font-weight: 500;
		padding: 0 0.125rem;
	}

	/* Tag styling */
	#search .pagefind-ui__result [data-pagefind-filter="tag"] {
		display: inline-block !important;
		padding: 0.125rem 0.5rem;
		margin: 0.125rem 0.25rem 0.125rem 0;
		font-size: 0.75rem !important;
		font-family: inherit;
		background-color: hsl(var(--color-bg-secondary));
		border: 1px solid hsl(var(--color-border));
		color: hsl(var(--color-text-secondary)) !important;
		text-decoration: none !important;
		transition: all 150ms ease;
	}

	#search .pagefind-ui__result [data-pagefind-filter="tag"]:hover {
		border-color: hsl(var(--color-accent));
		color: hsl(var(--color-text)) !important;
	}

	/* Messages styling */
	#search .pagefind-ui__message {
		color: hsl(var(--color-text-secondary)) !important;
		font-family: inherit !important;
		font-size: 0.875rem !important;
		text-align: center;
		padding: 2rem 1rem;
	}

	/* Custom scrollbar for results */
	#search .pagefind-ui__results::-webkit-scrollbar {
		width: 6px;
	}

	#search .pagefind-ui__results::-webkit-scrollbar-track {
		background: transparent;
	}

	#search .pagefind-ui__results::-webkit-scrollbar-thumb {
		background: hsl(var(--color-border));
	}

	#search .pagefind-ui__results::-webkit-scrollbar-thumb:hover {
		background: hsl(var(--color-text-secondary));
	}

	/* Hide unwanted elements */
	#search .pagefind-ui__result-thumb {
		display: block !important;
	}

	#search .pagefind-ui__drawer {
		display: block !important;
	}

	@media (max-width: 640px) {
		.search-instructions {
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
		}
	}
</style>
