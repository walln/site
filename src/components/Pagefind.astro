---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<!-- Search trigger button -->
<button
	id="magnifying-glass"
	type="button"
	class="p-2 text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors"
	aria-label="Search"
	title="Search (Ctrl+K or /)"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="w-5 h-5"
		aria-hidden="true"
	>
		<circle cx="11" cy="11" r="8" />
		<path d="m21 21-4.3-4.3" />
	</svg>
</button>

<aside data-pagefind-ignore>
	<div
		transition:persist
		id="backdrop"
		class="hidden fixed inset-0 z-[999999] flex justify-center p-6 pt-[15vh] bg-bg/80 backdrop-blur"
	>
		<div
			id="pagefind-container"
			class="h-fit w-full max-w-xl bg-bg border border-border shadow-2xl overflow-hidden"
		>
			<div class="p-4">
				<PagefindConfig excerpt-length={15} />
				<pagefind-input placeholder="Search…" />
				<pagefind-summary />
				<pagefind-results />
				<div
					class="search-instructions flex justify-center gap-6 mt-4 pt-4 border-t border-border text-xs text-text-secondary"
				>
				<span class="flex items-center gap-1.5">
					<kbd class="px-1.5 py-0.5 border border-border text-[0.7rem] bg-bg-secondary">Tab</kbd>
					Navigate
				</span>
				<span class="flex items-center gap-1.5">
					<kbd class="px-1.5 py-0.5 border border-border text-[0.7rem] bg-bg-secondary">Esc</kbd>
					Close
				</span>
				</div>
			</div>
		</div>
	</div>
</aside>

<script is:inline>
	const magnifyingGlass = document.getElementById("magnifying-glass");
	const backdrop = document.getElementById("backdrop");

	// Move backdrop to body to ensure it's not constrained by parent elements
	if (backdrop && backdrop.parentElement !== document.body) {
		document.body.appendChild(backdrop);
	}

	function openPagefind() {
		const searchInput = document.querySelector("pagefind-input input");
		setTimeout(() => {
			searchInput?.focus();
		}, 0);
		backdrop?.classList.remove("hidden");
		backdrop?.classList.add("block");
	}

	function closePagefind() {
		const searchInput = document.querySelector("pagefind-input input");
		if (searchInput) {
			searchInput.value = "";
			searchInput.dispatchEvent(new Event("input", { bubbles: true }));
		}
		backdrop?.classList.remove("block");
		backdrop?.classList.add("hidden");
	}

	// open pagefind
	magnifyingGlass?.addEventListener("click", () => {
		openPagefind();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "/") {
			e.preventDefault();
			openPagefind();
		} else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
			e.preventDefault();
			openPagefind();
		}
	});

	// close pagefind
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			closePagefind();
		}
	});

	// close pagefind when searched result(link) clicked
	document.addEventListener("click", (event) => {
		const target = event.target;
		if (
			target instanceof HTMLElement &&
			target.classList.contains("pf-result-link")
		) {
			closePagefind();
		}
	});

	backdrop?.addEventListener("click", (event) => {
		if (!event.target.closest("#pagefind-container")) {
			closePagefind();
		}
	});

	// prevent form submission
	const form = document.getElementById("form");
	form?.addEventListener("submit", (event) => {
		event.preventDefault();
	});
</script>

<style is:global>
	/* Ensure backdrop is always on top */
	#backdrop {
		position: fixed !important;
		z-index: 999999 !important;
	}

	#backdrop.block {
		display: flex !important;
	}

	/* Theme the Pagefind Component UI to match the site */
	:root {
		--pf-font: inherit;
		--pf-text: var(--color-text);
		--pf-text-secondary: var(--color-text-secondary);
		--pf-text-muted: var(--color-text-secondary);
		--pf-background: transparent;
		--pf-border: var(--color-border);
		--pf-border-focus: var(--color-accent);
		--pf-hover: var(--color-bg-secondary);
		--pf-mark: var(--color-accent);
		--pf-border-radius: 0;
	}

	pagefind-input {
		display: block;
		margin-bottom: 1rem;
	}

	pagefind-summary {
		display: block;
		padding: 2rem 1rem;
		text-align: center;
		color: var(--color-text-secondary);
		font-size: 0.875rem;
	}

	pagefind-results {
		display: block;
		max-height: 45vh;
		min-height: 100px;
		overflow-y: auto;
		padding: 0.25rem;
	}

	/* Custom scrollbar for results */
	pagefind-results::-webkit-scrollbar {
		width: 6px;
	}

	pagefind-results::-webkit-scrollbar-track {
		background: transparent;
	}

	pagefind-results::-webkit-scrollbar-thumb {
		background: var(--color-border);
	}

	pagefind-results::-webkit-scrollbar-thumb:hover {
		background: var(--color-text-secondary);
	}

	/* Highlight styling */
	pagefind-results mark {
		color: var(--color-accent) !important;
		background-color: color-mix(in srgb, var(--color-accent) 10%, transparent) !important;
		font-weight: 500;
		padding: 0 0.125rem;
	}

	@media (max-width: 640px) {
		.search-instructions {
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
		}
	}
</style>
