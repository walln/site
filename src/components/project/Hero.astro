---
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";

import FormattedDate from "@/components/FormatDate.astro";
import HeaderGraphic from "@/components/project/HeaderGraphic";

interface Props {
	content: CollectionEntry<"project">;
}

const {
	content: { data, render },
} = Astro.props;

const { remarkPluginFrontmatter } = await render();

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
	day: "numeric",
	year: "numeric",
};
---

{
	data.draft && (
		<span class="mb-3 inline-block font-label text-xs tracking-wide text-text-secondary uppercase">
			Draft
		</span>
	)
}
<FormattedDate
	class="project-date"
	date={data.publishDate}
	dateTimeOptions={dateTimeOptions}
/>
<h1 class="project-title">
	{data.title}
</h1>
{
	data.abstract && (
		<p class="project-subtitle">{data.abstract}</p>
	)
}
<div class="project-meta">
	<span>{remarkPluginFrontmatter.minutesRead}</span>
	{
		data.updatedDate && (
			<>
				<span class="project-meta-dot" aria-hidden="true">·</span>
				<span>
					Updated{" "}
					<FormattedDate
						date={data.updatedDate}
						dateTimeOptions={{ month: "long", year: "numeric" }}
					/>
				</span>
			</>
		)
	}
</div>
{
	data.graphic && (
		<div class="project-graphic">
			<HeaderGraphic client:load kind={data.graphic} />
		</div>
	)
}
{
	data.coverImage && (
		<div class="project-graphic overflow-hidden">
			<Image
				alt={data.coverImage.alt}
				class="object-cover w-full"
				fetchpriority="high"
				loading="eager"
				src={data.coverImage.src}
			/>
		</div>
	)
}
