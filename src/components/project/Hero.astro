---
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";

import FormattedDate from "@/components/FormatDate.astro";

interface Props {
	content: CollectionEntry<"project">;
}

const {
	content: { data, render },
} = Astro.props;

const { remarkPluginFrontmatter } = await render();

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
	year: "numeric",
};
---

{
	data.coverImage && (
		<div class="aspect-h-9 aspect-w-16 mb-8 overflow-hidden">
			<Image
				alt={data.coverImage.alt}
				class="object-cover"
				fetchpriority="high"
				loading="eager"
				src={data.coverImage.src}
			/>
		</div>
	)
}
{data.draft && <span class="text-sm text-text-secondary mb-2 inline-block">(Draft)</span>}
<h1 class="text-3xl sm:text-4xl font-mono font-bold tracking-tight mb-4">
	{data.title}
</h1>
<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-secondary">
	<span>
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} />
	</span>
	<span class="text-border">•</span>
	<span>{remarkPluginFrontmatter.minutesRead}</span>
	{
		data.updatedDate && (
			<>
				<span class="text-border">•</span>
				<span class="text-text-secondary">
					Updated{" "}
					<FormattedDate
						date={data.updatedDate}
						dateTimeOptions={dateTimeOptions}
					/>
				</span>
			</>
		)
	}
</div>
{
	!!data.tags?.length && (
		<div class="mt-4 flex flex-wrap gap-2">
			{data.tags.map((tag) => (
				<a
					href={`/tags/${tag}/`}
					class="tag"
					aria-label={`View more projects with the tag ${tag}`}
					data-pagefind-filter="tag"
				>
					{tag}
				</a>
			))}
		</div>
	)
}
