---
import type { TableOfContentsItem } from "@/utils/table-of-contents";

interface Props {
	heading: TableOfContentsItem;
}

const {
	heading: { depth, slug, children, text },
} = Astro.props;
---

<li class={depth > 2 ? "ml-4" : ""}>
	<a
		href={`#${slug}`}
		class={`block py-1 text-text-secondary hover:text-text transition-colors line-clamp-2 ${
			depth <= 2 ? "font-medium" : "text-sm"
		}`}
		aria-label={`Scroll to section: ${text}`}
	>
		{text}
	</a>
	{
		!!children.length && (
			<ul class="space-y-0.5">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
