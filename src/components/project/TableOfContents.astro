---
import type { MarkdownHeading } from "astro";

import { generateTableOfContents } from "@/utils/table-of-contents";

import Heading from "./TableOfContentsHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateTableOfContents(headings);
---

<aside class="sticky top-24 order-2 -me-32 hidden basis-64 lg:block">
	<h2 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-4">
		On this page
	</h2>
	<ul class="text-sm space-y-1">
		{toc.map((heading) => <Heading heading={heading} />)}
	</ul>
</aside>
