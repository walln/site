---
import Socials from "@/components/Socials.astro";
import { menuLinks } from "@/site.config";

const url = new URL(Astro.request.url);

const isActive = (path: string) =>
	url.pathname === path || (path !== "/" && url.pathname.startsWith(path));
---

<style>
	/*
	 * The overlay (z-50) sits above page content (z-10) but below the header
	 * (z-60), so the wordmark stays visible and the hamburger morphs into the
	 * close button in place.
	 */
	.mobile-menu {
		visibility: hidden;
		opacity: 0;
		background: color-mix(in srgb, var(--color-bg) 90%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			opacity 200ms ease,
			visibility 0s 200ms;
	}

	.mobile-menu.open {
		visibility: visible;
		opacity: 1;
		transition:
			opacity 250ms ease,
			visibility 0s;
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.mobile-menu {
			background: var(--color-bg);
		}
	}

	/* Staggered rise-in for menu items; fast un-staggered fade on close */
	.mobile-menu-item {
		opacity: 0;
		transform: translateY(0.85rem);
		transition:
			opacity 150ms ease,
			transform 150ms ease;
	}

	.mobile-menu.open .mobile-menu-item {
		opacity: 1;
		transform: none;
		transition:
			opacity 400ms ease,
			transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(50ms + var(--stagger) * 50ms);
	}

	/* Accent hairline under the current page, mirroring the desktop nav */
	.mobile-menu-link {
		position: relative;
		display: inline-block;
	}

	.mobile-menu-link::after {
		content: "";
		position: absolute;
		bottom: -0.1em;
		left: 0;
		height: 1px;
		width: 0;
		background-color: var(--color-accent);
		transition: width 300ms ease;
	}

	.mobile-menu-link:hover::after,
	.mobile-menu-link[aria-current="page"]::after {
		width: 100%;
	}

	/* Hamburger that morphs into a close cross */
	.menu-toggle-icon {
		display: block;
		position: relative;
		width: 1.125rem;
		height: 1rem;
	}

	.menu-toggle-line {
		position: absolute;
		left: 0;
		top: calc(50% - 0.75px);
		width: 100%;
		height: 1.5px;
		background-color: currentColor;
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.menu-toggle-line:first-child {
		transform: translateY(-3.5px);
	}

	.menu-toggle-line:last-child {
		transform: translateY(3.5px);
	}

	.menu-toggle[aria-expanded="true"] {
		color: var(--color-text);
	}

	.menu-toggle[aria-expanded="true"] .menu-toggle-line:first-child {
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded="true"] .menu-toggle-line:last-child {
		transform: rotate(-45deg);
	}
</style>

<header id="main-header" class="z-[60]">
	<nav class="flex items-center justify-between" aria-label="Main navigation">
		<div class="flex items-center gap-8">
			<a
				href="/"
				class="lowercase text-lg font-sans font-medium tracking-tight text-text hover:text-accent transition-colors"
				aria-current={url.pathname === "/" ? "page" : false}
			>
				Nick Wall
			</a>
			<div class="hidden sm:flex items-center gap-6">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class={`lowercase text-sm transition-colors relative group ${
								isActive(link.path)
									? "text-text"
									: "text-text-secondary hover:text-text"
							}`}
							aria-current={isActive(link.path) ? "page" : false}
							data-astro-prefetch
						>
							{link.title}
							<span
								class={`absolute -bottom-1 left-0 h-px bg-accent transition-all ${
									isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"
								}`}
							/>
						</a>
					))
				}
			</div>
		</div>

		<div class="flex items-center gap-2">
			<!-- Mobile menu toggle -->
			<button
				type="button"
				id="toggle-navigation-menu"
				class="menu-toggle sm:hidden p-2 -mr-2 text-text-secondary hover:text-text transition-colors"
				aria-expanded="false"
				aria-label="Open menu"
				aria-controls="mobile-navigation-menu"
			>
				<span class="menu-toggle-icon" aria-hidden="true">
					<span class="menu-toggle-line"></span>
					<span class="menu-toggle-line"></span>
				</span>
			</button>
		</div>
	</nav>
</header>

<!-- Full-screen mobile menu overlay - sibling of header so it can sit beneath it -->
<div id="mobile-navigation-menu" class="mobile-menu fixed inset-0 z-50 sm:hidden">
	<div class="mx-auto flex h-full max-w-3xl flex-col px-8">
		<nav class="flex flex-1 flex-col justify-center" aria-label="Mobile navigation">
			<ul class="flex flex-col items-start gap-5">
				{
					menuLinks.map((link, index) => (
						<li class="mobile-menu-item" style={`--stagger: ${index}`}>
							<a
								href={link.path}
								class={`mobile-menu-link font-serif lowercase text-4xl leading-none tracking-[-0.015em] transition-colors ${
									isActive(link.path)
										? "text-text"
										: "text-text-secondary hover:text-text"
								}`}
								aria-current={isActive(link.path) ? "page" : false}
								data-astro-prefetch
							>
								{link.title}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div
			class="mobile-menu-item pb-[calc(3rem+env(safe-area-inset-bottom))]"
			style={`--stagger: ${menuLinks.length}`}
		>
			<p
				class="mb-4 font-label text-[0.68rem] font-medium uppercase tracking-[0.14em] text-text-secondary"
			>
				connect
			</p>
			<Socials />
		</div>
	</div>
</div>

<script>
	(function () {
		let currentCleanup: (() => void) | null = null;

		function setupMobileMenu() {
			currentCleanup?.();

			const toggle = document.getElementById("toggle-navigation-menu");
			const menu = document.getElementById("mobile-navigation-menu");
			const wordmark = document.querySelector<HTMLAnchorElement>(
				'#main-header a[href="/"]',
			);
			if (!toggle || !menu) return;

			// <html> attributes survive view transitions; clear any stale lock.
			document.documentElement.style.overflow = "";

			const menuAnchors = Array.from(
				menu.querySelectorAll<HTMLAnchorElement>("a"),
			);
			const isOpen = () => menu.classList.contains("open");

			const setOpen = (open: boolean) => {
				menu.classList.toggle("open", open);
				toggle.setAttribute("aria-expanded", String(open));
				toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
				// The page scrolls on <html> (overflow-y: scroll), so lock there.
				document.documentElement.style.overflow = open ? "hidden" : "";
			};

			const handleToggle = () => setOpen(!isOpen());

			// Any tap on the overlay closes it - links navigate, blank space dismisses.
			const handleMenuClick = () => setOpen(false);

			const handleKeydown = (e: KeyboardEvent) => {
				if (!isOpen()) return;

				if (e.key === "Escape") {
					setOpen(false);
					toggle.focus();
					return;
				}

				// Keep Tab cycling within the visible controls while open.
				if (e.key === "Tab") {
					const focusables: HTMLElement[] = [
						...(wordmark ? [wordmark] : []),
						toggle,
						...menuAnchors,
					];
					const index = focusables.indexOf(
						document.activeElement as HTMLElement,
					);
					if (index === -1) return;
					const next = index + (e.shiftKey ? -1 : 1);
					if (next < 0) {
						e.preventDefault();
						focusables[focusables.length - 1].focus();
					} else if (next >= focusables.length) {
						e.preventDefault();
						focusables[0].focus();
					}
				}
			};

			// Rotating to landscape can cross the sm breakpoint, which hides the
			// menu via CSS - release the scroll lock too.
			const desktopQuery = window.matchMedia("(min-width: 640px)");
			const handleBreakpointChange = () => {
				if (desktopQuery.matches && isOpen()) setOpen(false);
			};

			toggle.addEventListener("click", handleToggle);
			menu.addEventListener("click", handleMenuClick);
			document.addEventListener("keydown", handleKeydown);
			desktopQuery.addEventListener("change", handleBreakpointChange);

			currentCleanup = () => {
				toggle.removeEventListener("click", handleToggle);
				menu.removeEventListener("click", handleMenuClick);
				document.removeEventListener("keydown", handleKeydown);
				desktopQuery.removeEventListener("change", handleBreakpointChange);
			};
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setupMobileMenu);
		} else {
			setupMobileMenu();
		}

		// Re-setup after Astro view transitions
		document.addEventListener("astro:page-load", setupMobileMenu);
	})();
</script>
