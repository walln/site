---
import Socials from "@/components/Socials.astro";
import { menuLinks } from "@/site.config";

const url = new URL(Astro.request.url);

const isCurrent = (path: string) =>
	url.pathname === path || (path !== "/" && url.pathname.startsWith(path));
---

<header id="main-header">
	<nav class="flex items-center justify-between" aria-label="Main navigation">
		<div class="flex items-center gap-8">
			<a
				href="/"
				class="lowercase text-lg font-sans font-medium tracking-tight text-text hover:text-accent transition-colors"
				aria-current={url.pathname === "/" ? "page" : false}
			>
				Nick Wall
			</a>
			<div class="hidden sm:flex items-center gap-6">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class={`lowercase text-sm transition-colors relative group ${
								isCurrent(link.path)
									? "text-text"
									: "text-text-secondary hover:text-text"
							}`}
							aria-current={isCurrent(link.path) ? "page" : false}
							data-astro-prefetch
						>
							{link.title}
							<span
								class={`absolute -bottom-1 left-0 h-px bg-accent transition-all ${
									isCurrent(link.path)
										? "w-full"
										: "w-0 group-hover:w-full"
								}`}
							/>
						</a>
					))
				}
			</div>
		</div>

		<button
			type="button"
			id="toggle-navigation-menu"
			class="menu-toggle sm:hidden"
			aria-expanded="false"
			aria-label="Open menu"
			aria-controls="mobile-navigation-menu"
		>
			menu
		</button>
	</nav>
</header>

<!--
	The mobile navigation is a full-bleed index sheet rather than a drawer: it
	sits outside <header> so it owns its own stacking context, and its top row
	is positioned to land exactly on the header it covers, so opening the menu
	reads as the page expanding rather than a panel arriving.
-->
<div id="mobile-navigation-menu" class="menu-sheet sm:hidden">
	<div class="menu-scrim" id="mobile-menu-scrim"></div>

	<div class="menu-topline">
		<a
			href="/"
			class="lowercase text-lg font-sans font-medium tracking-tight text-text"
			data-menu-link>Nick Wall</a
		>
		<button
			type="button"
			id="close-navigation-menu"
			class="menu-toggle menu-toggle-close"
			aria-label="Close menu">close</button
		>
	</div>

	<nav class="menu-index" aria-label="Mobile navigation">
		<ol class="menu-list">
			{
				menuLinks.map((link, i) => (
					<li class="menu-item" style={`--i:${i}`}>
						<a
							href={link.path}
							class="menu-link"
							aria-current={isCurrent(link.path) ? "page" : false}
							data-astro-prefetch
							data-menu-link
						>
							<span class="menu-item-index">
								{String(i + 1).padStart(2, "0")}
							</span>
							<span>
								<span class="menu-item-title">{link.title}</span>
								<span class="menu-item-blurb">{link.blurb}</span>
							</span>
						</a>
					</li>
				))
			}
		</ol>

		<div class="menu-foot" style={`--i:${menuLinks.length}`}>
			<p class="menu-foot-label">Elsewhere</p>
			<div class="menu-foot-socials">
				<Socials />
			</div>
		</div>
	</nav>
</div>

<style>
	/*
	 * The toggle is a word, not a hamburger: every other action on this site is
	 * set as text (back to top, view all), and an icon button is the only piece
	 * of chrome that would be.
	 */
	.menu-toggle {
		margin-right: -0.5rem;
		padding: 0.5rem;
		font-size: 0.875rem;
		text-transform: lowercase;
		color: var(--color-text-secondary);
		transition: color 200ms ease;
	}

	.menu-toggle:hover,
	.menu-sheet.open .menu-toggle-close {
		color: var(--color-text);
	}

	.menu-sheet {
		/*
		 * Fallbacks for the body/header spacing in global.css; the open handler
		 * measures the live header and overwrites both so the sheet stays
		 * registered to it in either page layout.
		 */
		--menu-top: 6rem;
		--menu-gutter: 2rem;

		position: fixed;
		inset: 0;
		/* Above content (10) and the back-to-top pill (40), below the palette (200). */
		z-index: 50;
		visibility: hidden;
		pointer-events: none;
	}

	.menu-sheet.open {
		visibility: visible;
		pointer-events: auto;
	}

	/* Paper, not a modal: the page stays faintly legible underneath. */
	.menu-scrim {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--color-bg) 90%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		opacity: 0;
		transition: opacity 260ms ease;
	}

	.menu-sheet.open .menu-scrim {
		opacity: 1;
	}

	.menu-topline {
		position: absolute;
		top: var(--menu-top);
		left: var(--menu-gutter);
		right: var(--menu-gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.menu-sheet.open .menu-topline {
		opacity: 1;
	}

	.menu-index {
		position: absolute;
		top: calc(var(--menu-top) + 4rem);
		left: var(--menu-gutter);
		right: var(--menu-gutter);
		bottom: 0;
		display: flex;
		flex-direction: column;
		padding-bottom: 2rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.menu-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.menu-item {
		border-top: 1px solid var(--color-border);
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 360ms ease,
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.menu-item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.menu-foot {
		margin-top: auto;
		padding-top: 2.75rem;
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 360ms ease,
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Entries settle in sequence on open, and leave together on close. */
	.menu-sheet.open .menu-item,
	.menu-sheet.open .menu-foot {
		opacity: 1;
		transform: none;
		transition-delay: calc(var(--i) * 45ms + 90ms);
	}

	.menu-link {
		position: relative;
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: baseline;
		padding: 1.15rem 0;
	}

	/* Current page: the accent rule and index, as in the post table of contents. */
	.menu-link::before {
		content: "";
		position: absolute;
		left: calc(var(--menu-gutter) * -0.5);
		top: 1.25rem;
		bottom: 1.25rem;
		width: 1px;
		background: var(--color-accent);
		opacity: 0;
		transform: scaleY(0.5);
		transform-origin: top;
		transition:
			opacity 200ms ease,
			transform 260ms ease;
	}

	.menu-link[aria-current="page"]::before {
		opacity: 1;
		transform: none;
	}

	.menu-item-index {
		font-family: var(--font-label);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		font-variant-numeric: tabular-nums;
		color: var(--color-text-secondary);
		transition: color 200ms ease;
	}

	.menu-link[aria-current="page"] .menu-item-index {
		color: var(--color-accent);
	}

	.menu-item-title {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.9rem;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-transform: lowercase;
		color: var(--color-text);
		transition: color 200ms ease;
	}

	.menu-item-blurb {
		display: block;
		margin-top: 0.35rem;
		font-family: var(--font-serif);
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	/* Touch has no hover, so the press itself is the feedback. */
	.menu-link:active .menu-item-title {
		color: var(--color-accent);
	}

	.menu-foot-label {
		margin: 0 0 0.9rem;
		font-family: var(--font-label);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	/* Cancel the icon links' padding so the first glyph sits on the index edge. */
	.menu-foot-socials {
		margin-left: -0.375rem;
	}

	/* The real header would ghost through the scrim under the sheet's own copy. */
	:global(body.menu-open) #main-header {
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-item,
		.menu-foot {
			transform: none;
		}
	}
</style>

<script>
	(function () {
		let cleanup: (() => void) | null = null;

		function setup() {
			cleanup?.();
			cleanup = null;

			/*
			 * The scroll lock lives on <html>, which ClientRouter keeps across
			 * swaps, so a navigation from an open menu could otherwise leave the
			 * next page unscrollable. Always start from an unlocked state.
			 */
			document.documentElement.style.overflow = "";
			document.body.classList.remove("menu-open");

			const toggle = document.getElementById("toggle-navigation-menu");
			const closeButton = document.getElementById("close-navigation-menu");
			const sheet = document.getElementById("mobile-navigation-menu");
			const scrim = document.getElementById("mobile-menu-scrim");
			const header = document.getElementById("main-header");

			if (!toggle || !closeButton || !sheet || !scrim || !header) return;

			const openMenu = () => {
				/*
				 * Register the sheet to the header it covers, using the header's
				 * document offset rather than its viewport position so the top
				 * row lands correctly even when the page is scrolled.
				 */
				const headerTop =
					header.getBoundingClientRect().top + window.scrollY;
				sheet.style.setProperty("--menu-top", `${headerTop}px`);
				sheet.style.setProperty(
					"--menu-gutter",
					getComputedStyle(document.body).paddingLeft,
				);

				sheet.classList.add("open");
				document.body.classList.add("menu-open");
				document.documentElement.style.overflow = "hidden";
				toggle.setAttribute("aria-expanded", "true");
				closeButton.focus();
			};

			const closeMenu = () => {
				sheet.classList.remove("open");
				document.body.classList.remove("menu-open");
				document.documentElement.style.overflow = "";
				toggle.setAttribute("aria-expanded", "false");
				toggle.focus();
			};

			const handleEscape = (e: KeyboardEvent) => {
				if (e.key === "Escape" && sheet.classList.contains("open")) {
					closeMenu();
				}
			};

			const links = Array.from(
				sheet.querySelectorAll<HTMLAnchorElement>("[data-menu-link]"),
			);

			toggle.addEventListener("click", openMenu);
			closeButton.addEventListener("click", closeMenu);
			scrim.addEventListener("click", closeMenu);
			document.addEventListener("keydown", handleEscape);
			links.forEach((link) => link.addEventListener("click", closeMenu));

			cleanup = () => {
				toggle.removeEventListener("click", openMenu);
				closeButton.removeEventListener("click", closeMenu);
				scrim.removeEventListener("click", closeMenu);
				document.removeEventListener("keydown", handleEscape);
				links.forEach((link) =>
					link.removeEventListener("click", closeMenu),
				);
			};
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setup);
		} else {
			setup();
		}

		document.addEventListener("astro:page-load", setup);
	})();
</script>
