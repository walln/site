---
import Pagefind from "@/components/Pagefind.astro";
import ThemeToggle from "@/components/ThemeToggle";
import { menuLinks } from "@/site.config";

const url = new URL(Astro.request.url);
---

<header class="mb-16 mt-8" id="main-header">
	<nav class="flex items-center justify-between" aria-label="Main navigation">
		<div class="flex items-center gap-8">
			<a
				href="/"
				class="text-lg font-mono font-semibold tracking-tight text-text hover:text-accent transition-colors"
				aria-current={url.pathname === "/" ? "page" : false}
			>
				Nick Wall
			</a>
			<div class="hidden sm:flex items-center gap-6">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class={`text-sm transition-colors relative group ${
								url.pathname === link.path || 
								(link.path !== "/" && url.pathname.startsWith(link.path))
									? "text-text"
									: "text-text-secondary hover:text-text"
							}`}
							aria-current={
								url.pathname === link.path ||
								(link.path !== "/" && url.pathname.startsWith(link.path))
									? "page"
									: false
							}
							data-astro-prefetch
						>
							{link.title}
							<span
								class={`absolute -bottom-1 left-0 h-px bg-accent transition-all ${
									url.pathname === link.path ||
									(link.path !== "/" && url.pathname.startsWith(link.path))
										? "w-full"
										: "w-0 group-hover:w-full"
								}`}
							/>
						</a>
					))
				}
			</div>
		</div>

		<div class="flex items-center gap-2">
			<Pagefind />
			<ThemeToggle client:load />

			<!-- Mobile menu toggle -->
			<button
				type="button"
				id="toggle-navigation-menu"
				class="sm:hidden p-2 text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors"
				aria-expanded="false"
				aria-label="Open main menu"
				aria-controls="mobile-navigation-menu"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="w-5 h-5"
					aria-hidden="true"
				>
					<line x1="3" y1="6" x2="21" y2="6" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="18" x2="21" y2="18" />
				</svg>
			</button>
		</div>
	</nav>

	<!-- Mobile navigation drawer -->
	<div
		id="mobile-navigation-menu"
		class="fixed inset-0 z-50 hidden"
		aria-label="Mobile menu"
	>
		<!-- Backdrop -->
		<div
			class="absolute inset-0 bg-bg/80 backdrop-blur-sm"
			id="mobile-menu-backdrop"
		>
		</div>

		<!-- Menu panel -->
		<nav
			class="absolute right-0 top-0 h-full w-64 bg-bg border-l border-border p-6 shadow-lg"
		>
			<div class="flex justify-end mb-8">
				<button
					type="button"
					id="close-navigation-menu"
					class="p-2 text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors"
					aria-label="Close menu"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-5 h-5"
						aria-hidden="true"
					>
						<line x1="18" y1="6" x2="6" y2="18" />
						<line x1="6" y1="6" x2="18" y2="18" />
					</svg>
				</button>
			</div>

			<div class="flex flex-col gap-4">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class={`text-base py-2 transition-colors ${
								url.pathname === link.path ||
								(link.path !== "/" && url.pathname.startsWith(link.path))
									? "text-text font-medium"
									: "text-text-secondary hover:text-text"
							}`}
							aria-current={
								url.pathname === link.path ||
								(link.path !== "/" && url.pathname.startsWith(link.path))
									? "page"
									: false
							}
							data-astro-prefetch
						>
							{link.title}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>

<script>
	function setupMobileMenu() {
		const toggleButton = document.getElementById("toggle-navigation-menu");
		const closeButton = document.getElementById("close-navigation-menu");
		const mobileMenu = document.getElementById("mobile-navigation-menu");
		const backdrop = document.getElementById("mobile-menu-backdrop");

		if (!toggleButton || !closeButton || !mobileMenu || !backdrop) return;

		const openMenu = () => {
			mobileMenu.classList.remove("hidden");
			toggleButton.setAttribute("aria-expanded", "true");
			document.body.style.overflow = "hidden";
		};

		const closeMenu = () => {
			mobileMenu.classList.add("hidden");
			toggleButton.setAttribute("aria-expanded", "false");
			document.body.style.overflow = "";
		};

		toggleButton.addEventListener("click", openMenu);
		closeButton.addEventListener("click", closeMenu);
		backdrop.addEventListener("click", closeMenu);

		// Close on Escape key
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
				closeMenu();
			}
		});
	}

	// Initial setup
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupMobileMenu);
	} else {
		setupMobileMenu();
	}

	// Re-setup after Astro view transitions
	document.addEventListener("astro:page-load", setupMobileMenu);
</script>
